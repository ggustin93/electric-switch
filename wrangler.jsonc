// Déploiement Cloudflare Workers, ressources statiques uniquement (pas de script Worker) :
// dist/ est servi tel quel ; en-têtes (hreflang, sécurité) dans dist/_headers, adresse inconnue → dist/404.html (statut 404).
// Commande : npm run deploy
{
  "name": "electric-switch",
  "compatibility_date": "2026-10-07",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
